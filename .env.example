# Django Settings
DEBUG=False
SECRET_KEY=your-super-secure-random-secret-key-here
ALLOWED_HOSTS=your-staging-domain.com,www.your-staging-domain.com

# Database Configuration (provided by DigitalOcean)
# These will be set automatically by DO App Platform
# DATABASE_NAME=stationery_world_staging
# DATABASE_USER=doadmin
# DATABASE_PASSWORD=your_db_password
# DATABASE_HOST=your_db_host
# DATABASE_PORT=25060

# Email Configuration (for staging, using console backend)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# If you want real email in staging, uncomment and configure:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password

# Default emails
DEFAULT_FROM_EMAIL=info@stationeryworld.ug
SERVER_EMAIL=info@stationeryworld.ug

# Redis (optional for staging)
# REDIS_URL=redis://localhost:6379/1

# Media root (optional)
# MEDIA_ROOT=/app/media